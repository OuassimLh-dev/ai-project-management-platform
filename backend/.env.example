APP_NAME=AI Project Management Platform
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Example credentials only: replace with your local PostgreSQL configuration.
DATABASE_URL=postgresql://project_user:project_password@localhost:5432/ai_project_management
# Fake placeholder only: replace with a unique random secret of at least 32 characters.
JWT_SECRET_KEY=replace-this-fake-development-placeholder-before-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional AI: set provider to openai and choose a Responses model supporting structured outputs.
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=30

# Explicit browser origins; leave [] when cross-origin browser access is unnecessary.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
